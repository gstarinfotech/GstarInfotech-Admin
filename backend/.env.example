PORT=4001
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@gstarinfotech.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
# Optional: legacy website data directory used by the one-time importer
LEGACY_DATA_DIR=../../GstarInfotech_Website/data
LEGACY_CASE_STUDIES_FILE=../../GstarInfotech_Website/data/case-studies.json
# Local default: backend/uploads. On VPS use a persistent writable directory.
UPLOAD_DIR=./uploads
# Public base URL of the API server (use the HTTPS API domain in production).
UPLOAD_BASE_URL=http://localhost:4001